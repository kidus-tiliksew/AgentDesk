---
// PROTOTYPE ONLY: a bare document shell with no global.css, so each redesign
// direction under src/pages/proto/ owns its whole stylesheet.
import { SITE_DESCRIPTION, SITE_TITLE } from "../site";

interface Props {
  title?: string;
}
const { title = SITE_TITLE } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={SITE_DESCRIPTION} />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body>
    <slot />
  </body>
</html>
