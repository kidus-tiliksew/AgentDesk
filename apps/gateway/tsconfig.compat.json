{
  "extends": "./tsconfig.test.json",
  "compilerOptions": {
    // The installer modules these tests import reach Node-only modules, so
    // these tests also see Node types. The Worker and its other tests stay
    // without them.
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types", "node"]
  },
  "include": [
    "test/installer-compatibility.test.ts",
    "test/waiter-compatibility.test.ts",
    "test/env.d.ts",
    "src/modules.d.ts"
  ]
}
