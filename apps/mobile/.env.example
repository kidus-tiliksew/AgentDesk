# Copy to .env and replace the placeholders (component-repository §Configuration).
# The Convex deployment URL, from the Convex dashboard.
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# The Clerk publishable key, from the Clerk dashboard.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Optional. The PostHog project token, which starts with phc_. Leave it unset
# to turn analytics off.
EXPO_PUBLIC_POSTHOG_KEY=
# Optional. The PostHog ingestion host; defaults to https://us.i.posthog.com.
EXPO_PUBLIC_POSTHOG_HOST=
