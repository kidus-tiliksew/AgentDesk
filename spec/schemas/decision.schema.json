{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_session_id": {
      "type": ["string", "null"]
    },
    "answer": {
      "anyOf": [
        {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "approve",
                  "type": "string"
                }
              },
              "required": ["kind"],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "reject",
                  "type": "string"
                }
              },
              "required": ["kind"],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "option",
                  "type": "string"
                },
                "option_id": {
                  "type": "string"
                }
              },
              "required": ["kind", "option_id"],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "options",
                  "type": "string"
                },
                "option_ids": {
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1,
                  "type": "array"
                }
              },
              "required": ["kind", "option_ids"],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "text",
                  "type": "string"
                },
                "text": {
                  "maxLength": 4000,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": ["kind", "text"],
              "type": "object"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "answered_at": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "answered_via": {
      "anyOf": [
        {
          "enum": ["app", "notification", "api", "chat", "default"],
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "applied_by_default": {
      "type": "boolean"
    },
    "body": {
      "anyOf": [
        {
          "maxLength": 16000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "chat_message": {
      "anyOf": [
        {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "The user's chat message, word for word, when answered_via is chat; null otherwise."
    },
    "created_at": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "deadline": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "default": {
      "anyOf": [
        {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "approve",
                  "type": "string"
                }
              },
              "required": ["kind"],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "reject",
                  "type": "string"
                }
              },
              "required": ["kind"],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "option",
                  "type": "string"
                },
                "option_id": {
                  "type": "string"
                }
              },
              "required": ["kind", "option_id"],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "options",
                  "type": "string"
                },
                "option_ids": {
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1,
                  "type": "array"
                }
              },
              "required": ["kind", "option_ids"],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "text",
                  "type": "string"
                },
                "text": {
                  "maxLength": 4000,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": ["kind", "text"],
              "type": "object"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "follow_up_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "id": {
      "type": "string"
    },
    "input_type": {
      "enum": [
        "approve_reject",
        "single_choice",
        "multiple_choice",
        "free_text",
        "single_choice_or_text"
      ],
      "type": "string"
    },
    "interactive": {
      "description": "True when the user may be watching this session and can answer in its chat",
      "type": "boolean"
    },
    "note": {
      "type": ["string", "null"]
    },
    "options": {
      "anyOf": [
        {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "maxLength": 80,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": ["id", "label"],
            "type": "object"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "parent_id": {
      "type": ["string", "null"]
    },
    "priority": {
      "enum": ["normal", "urgent"],
      "type": "string"
    },
    "recommendation": {
      "anyOf": [
        {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "approve",
                  "type": "string"
                }
              },
              "required": ["kind"],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "reject",
                  "type": "string"
                }
              },
              "required": ["kind"],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "option",
                  "type": "string"
                },
                "option_id": {
                  "type": "string"
                }
              },
              "required": ["kind", "option_id"],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "options",
                  "type": "string"
                },
                "option_ids": {
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1,
                  "type": "array"
                }
              },
              "required": ["kind", "option_ids"],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "text",
                  "type": "string"
                },
                "text": {
                  "maxLength": 4000,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": ["kind", "text"],
              "type": "object"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "relayed_by_agent_session_id": {
      "description": "The agent session that relayed the chat answer when answered_via is chat; null otherwise.",
      "type": ["string", "null"]
    },
    "state": {
      "enum": ["pending", "answered", "expired", "cancelled"],
      "type": "string"
    },
    "title": {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
    },
    "topic": {
      "pattern": "^[a-z0-9._/-]{1,100}$",
      "type": "string"
    }
  },
  "required": [
    "id",
    "topic",
    "title",
    "body",
    "input_type",
    "options",
    "recommendation",
    "priority",
    "interactive",
    "deadline",
    "default",
    "state",
    "answer",
    "note",
    "answered_at",
    "answered_via",
    "chat_message",
    "relayed_by_agent_session_id",
    "applied_by_default",
    "parent_id",
    "follow_up_ids",
    "agent_session_id",
    "created_at"
  ],
  "title": "Decision",
  "type": "object"
}
