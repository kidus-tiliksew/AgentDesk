{
  "components": {
    "schemas": {
      "AgentSession": {
        "additionalProperties": false,
        "properties": {
          "display_name": {
            "type": "string"
          },
          "ended_at": {
            "anyOf": [
              {
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "type": "string"
          },
          "last_activity_at": {
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "type": "string"
          },
          "line": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "link": {
            "anyOf": [
              {
                "description": "An absolute http or https URL.",
                "format": "uri",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "pending_decision_count": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "stale": {
            "type": "boolean"
          },
          "state": {
            "anyOf": [
              {
                "enum": ["working", "waiting", "blocked", "done"],
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "status_at": {
            "anyOf": [
              {
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "topic": {
            "pattern": "^[a-z0-9._/-]{1,100}$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "display_name",
          "topic",
          "state",
          "line",
          "link",
          "status_at",
          "last_activity_at",
          "stale",
          "ended_at",
          "pending_decision_count"
        ],
        "type": "object"
      },
      "AgentSessionPage": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AgentSession"
            },
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["items", "next_cursor"],
        "type": "object"
      },
      "AnswerSubmission": {
        "properties": {
          "answer": {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "approve",
                    "type": "string"
                  }
                },
                "required": ["kind"],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "reject",
                    "type": "string"
                  }
                },
                "required": ["kind"],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "option",
                    "type": "string"
                  },
                  "option_id": {
                    "type": "string"
                  }
                },
                "required": ["kind", "option_id"],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "options",
                    "type": "string"
                  },
                  "option_ids": {
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  }
                },
                "required": ["kind", "option_ids"],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "text",
                    "type": "string"
                  },
                  "text": {
                    "maxLength": 4000,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": ["kind", "text"],
                "type": "object"
              }
            ]
          },
          "note": {
            "maxLength": 2000,
            "type": "string"
          }
        },
        "required": ["answer"],
        "type": "object"
      },
      "Decision": {
        "additionalProperties": false,
        "properties": {
          "agent_session_id": {
            "type": ["string", "null"]
          },
          "answer": {
            "anyOf": [
              {
                "oneOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "approve",
                        "type": "string"
                      }
                    },
                    "required": ["kind"],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "reject",
                        "type": "string"
                      }
                    },
                    "required": ["kind"],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "option",
                        "type": "string"
                      },
                      "option_id": {
                        "type": "string"
                      }
                    },
                    "required": ["kind", "option_id"],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "options",
                        "type": "string"
                      },
                      "option_ids": {
                        "items": {
                          "type": "string"
                        },
                        "minItems": 1,
                        "type": "array"
                      }
                    },
                    "required": ["kind", "option_ids"],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "text",
                        "type": "string"
                      },
                      "text": {
                        "maxLength": 4000,
                        "minLength": 1,
                        "type": "string"
                      }
                    },
                    "required": ["kind", "text"],
                    "type": "object"
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "answered_at": {
            "anyOf": [
              {
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "answered_via": {
            "anyOf": [
              {
                "enum": ["app", "notification", "api", "default"],
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "applied_by_default": {
            "type": "boolean"
          },
          "body": {
            "anyOf": [
              {
                "maxLength": 16000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "type": "string"
          },
          "deadline": {
            "anyOf": [
              {
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "default": {
            "anyOf": [
              {
                "oneOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "approve",
                        "type": "string"
                      }
                    },
                    "required": ["kind"],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "reject",
                        "type": "string"
                      }
                    },
                    "required": ["kind"],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "option",
                        "type": "string"
                      },
                      "option_id": {
                        "type": "string"
                      }
                    },
                    "required": ["kind", "option_id"],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "options",
                        "type": "string"
                      },
                      "option_ids": {
                        "items": {
                          "type": "string"
                        },
                        "minItems": 1,
                        "type": "array"
                      }
                    },
                    "required": ["kind", "option_ids"],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "text",
                        "type": "string"
                      },
                      "text": {
                        "maxLength": 4000,
                        "minLength": 1,
                        "type": "string"
                      }
                    },
                    "required": ["kind", "text"],
                    "type": "object"
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "follow_up_ids": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "type": "string"
          },
          "input_type": {
            "enum": [
              "approve_reject",
              "single_choice",
              "multiple_choice",
              "free_text",
              "single_choice_or_text"
            ],
            "type": "string"
          },
          "note": {
            "type": ["string", "null"]
          },
          "options": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "label": {
                      "maxLength": 80,
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": ["id", "label"],
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ]
          },
          "parent_id": {
            "type": ["string", "null"]
          },
          "priority": {
            "enum": ["normal", "urgent"],
            "type": "string"
          },
          "recommendation": {
            "anyOf": [
              {
                "oneOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "approve",
                        "type": "string"
                      }
                    },
                    "required": ["kind"],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "reject",
                        "type": "string"
                      }
                    },
                    "required": ["kind"],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "option",
                        "type": "string"
                      },
                      "option_id": {
                        "type": "string"
                      }
                    },
                    "required": ["kind", "option_id"],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "options",
                        "type": "string"
                      },
                      "option_ids": {
                        "items": {
                          "type": "string"
                        },
                        "minItems": 1,
                        "type": "array"
                      }
                    },
                    "required": ["kind", "option_ids"],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "text",
                        "type": "string"
                      },
                      "text": {
                        "maxLength": 4000,
                        "minLength": 1,
                        "type": "string"
                      }
                    },
                    "required": ["kind", "text"],
                    "type": "object"
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "enum": ["pending", "answered", "expired", "cancelled"],
            "type": "string"
          },
          "title": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "topic": {
            "pattern": "^[a-z0-9._/-]{1,100}$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "topic",
          "title",
          "body",
          "input_type",
          "options",
          "recommendation",
          "priority",
          "deadline",
          "default",
          "state",
          "answer",
          "note",
          "answered_at",
          "answered_via",
          "applied_by_default",
          "parent_id",
          "follow_up_ids",
          "agent_session_id",
          "created_at"
        ],
        "type": "object"
      },
      "DecisionPage": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Decision"
            },
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["items", "next_cursor"],
        "type": "object"
      },
      "ErrorBody": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "enum": [
                  "invalid",
                  "unauthenticated",
                  "not_found",
                  "conflict",
                  "locked",
                  "rate_limited"
                ],
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": ["code", "message"],
            "type": "object"
          }
        },
        "required": ["error"],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "description": "An AgentDesk API token.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "List, read, answer, and cancel decisions, and list and read agent sessions. Clients ignore unknown response fields, because later versions may add fields.",
    "title": "AgentDesk HTTP API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/agent-sessions": {
      "get": {
        "operationId": "agent_sessions.list",
        "parameters": [
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "description": "The next_cursor of the previous page. Keep the other filters unchanged while paging.",
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "description": "The maximum number of items in the page.",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentSessionPage"
                }
              }
            },
            "description": "List agent sessions"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Error code `invalid`."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Error code `unauthenticated`."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Error code `rate_limited`."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List agent sessions"
      }
    },
    "/v1/agent-sessions/{agent_session_id}": {
      "get": {
        "operationId": "agent_sessions.get",
        "parameters": [
          {
            "in": "path",
            "name": "agent_session_id",
            "required": true,
            "schema": {
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentSession"
                }
              }
            },
            "description": "Get an agent session"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Error code `invalid`."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Error code `unauthenticated`."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Error code `not_found`."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Error code `rate_limited`."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get an agent session"
      }
    },
    "/v1/decisions": {
      "get": {
        "description": "Filters by state and topic. A topic filter also matches decisions under it: `a/b` matches `a/b/c` but not `a/bc`.",
        "operationId": "decisions.list",
        "parameters": [
          {
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "enum": ["pending", "answered", "expired", "cancelled"],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "topic",
            "required": false,
            "schema": {
              "description": "Lowercased, then matched against the pattern. Lists decisions in this topic and every topic under it.",
              "pattern": "^[a-z0-9._/-]{1,100}$",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "description": "The next_cursor of the previous page. Keep the other filters unchanged while paging.",
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "description": "The maximum number of items in the page.",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionPage"
                }
              }
            },
            "description": "List decisions"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Error code `invalid`."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Error code `unauthenticated`."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Error code `rate_limited`."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List decisions"
      }
    },
    "/v1/decisions/{decision_id}": {
      "get": {
        "operationId": "decisions.get",
        "parameters": [
          {
            "in": "path",
            "name": "decision_id",
            "required": true,
            "schema": {
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Decision"
                }
              }
            },
            "description": "Get a decision"
          },
          "400": {
            "content": {
