{
  "name": "agentdesk",
  "version": "0.0.0",
  "private": true,
  "description": "The agentdesk command: connects Claude Code, Codex, and Cursor to AgentDesk and installs the skill and the session-start guidance. Distributed as release binaries through install.sh.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kidus-tiliksew/AgentDesk.git",
    "directory": "packages/installer"
  },
  "bin": {
    "agentdesk": "dist/agentdesk.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:binaries": "node scripts/build-binaries.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "esbuild": "^0.28.2",
    "smol-toml": "^1.9.1",
    "typescript": "^5.9.3"
  }
}
